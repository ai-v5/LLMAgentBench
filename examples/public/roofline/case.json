  "allowed_write_paths": [
    "answer.json"
  ],
  "checks": [
    {
      "id": "compute",
      "type": "python",
      "script": "verify_compute.py"
    },
    {
      "id": "memory",
      "type": "python",
      "script": "verify_memory.py"
    },
    {
      "id": "lower-bound",
      "type": "python",
      "script": "verify_lower-bound.py"
